# Copy to .env (gitignored) in your private deployment repo. All values are placeholders.
AUTH_DOMAIN=auth.example.com
CONFIGURATOR_DOMAIN=authcfg.example.com
ADMIN_GROUP=admin
# REQUIRED. VPN/LAN networks allowed to reach the app. Empty -> the app refuses to start.
ALLOWED_CLIENT_CIDRS=10.8.0.0/24,192.168.1.0/24
# Docker network of your reverse proxy. Only these peers may set X-Forwarded-For / Remote-* headers.
TRUSTED_PROXY_CIDRS=172.20.0.0/16
AUTHELIA_CONTAINER=authelia
AUTHELIA_HEALTH_URL=http://authelia:9091/api/health
VERSION_MISMATCH=block

# REQUIRED, at least 32 bytes. Generate with:  openssl rand -base64 48
APP_SECRET_KEY=
