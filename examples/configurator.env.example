# Secrets and per-host values for compose.example.yml. Copy to a real file that is NOT committed.
AUTHELIA_VERSION=4.39.28
DOCKER_GID=999            # stat -c %g /var/run/docker.sock
AUTHELIA_UID=1000         # owner of ./authelia (the configurator writes ./authelia/managed)
AUTHELIA_GID=1000
APP_SECRET_KEY=           # openssl rand -base64 48
# NOTIFY_WEBHOOK_URL=     # optional; may contain a token, so keep it out of git
