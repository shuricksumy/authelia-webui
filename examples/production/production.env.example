# Copy to .env next to compose.yml and fill in. Never commit the filled file.
DOMAIN=example.com             # apps live at <name>.DOMAIN; the portal is auth.DOMAIN
AUTHELIA_VERSION=4.39.28       # also selects the configurator image tag
VPN_ADDRESS=10.8.0.1           # this host's address on the VPN (the configurator listens there only)
VPN_CIDR=10.8.0.0/24           # clients allowed to open the configurator
DOCKER_GID=999                 # stat -c %g /var/run/docker.sock
AUTHELIA_UID=1000              # owner of ./authelia (and ./authelia/managed)
AUTHELIA_GID=1000
ADMIN_GROUP=admin               # or a dedicated group with only you in it, e.g. configurator-admins
APP_SECRET_KEY=                # openssl rand -base64 48
REDIS_PASSWORD=                # openssl rand -base64 32 (Authelia's session store)
TZ=UTC
# NOTIFY_WEBHOOK_URL=          # optional, see the main README (may contain a token)
# Break-glass login for when Authelia is down (docs/emergency.md). Set both or neither.
# EMERGENCY_PORT=8090
# EMERGENCY_PASSWORD_HASH='$argon2id$...'   # single quotes: the digest contains $
# EMERGENCY_HOSTS=172.30.0.12  # optional: also answer at this IP (configurator's own, over the VPN)
# Owner opt-in, see the main README: use the configurator from any network (Authelia alone).
# ALLOW_ANY_CLIENT_NETWORK=true
