# SPEC §13 — never commit deployment data or secrets
*.sqlite3
configuration.yml
users.yml
# the contents of any managed/ folder (real deployment data), except the synthetic examples
**/managed/*
!examples/production/authelia/managed/*.example.yml
# Traefik Manager add-on runtime data (password hash, encryption keys, backups)
examples/production/traefik-manager/config/
examples/production/traefik-manager/backups/
.env
.env.*
!.env.example
keys/
*.pem
*.crt
*.key
notification.txt
*.log

# Generated test data (hashes, keys) — created at test time
tests/fixtures/generated/

# Claude Code personal settings
.claude/settings.local.json

